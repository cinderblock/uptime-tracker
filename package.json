{
  "name": "uptime-tracker",
  "version": "0.1.0",
  "description": "Self-hosted uptime monitoring, status dashboard, and push notifications on Cloudflare Workers — runs on the free plan",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "dev:local": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply UPTIME_DB --remote",
    "migrate:local": "wrangler d1 migrations apply UPTIME_DB --local",
    "pretest": "bun scripts/ensure-config.ts",
    "test": "bun test",
    "pretypecheck": "bun scripts/ensure-config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260117.0",
    "@types/bun": "^1.3.6",
    "prettier": "^3.8.0",
    "smol-toml": "^1.6.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
